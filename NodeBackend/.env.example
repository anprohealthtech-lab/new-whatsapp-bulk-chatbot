# Database Configuration
DATABASE_URL=postgresql://neondb_owner:npg_***@ep-noisy-grass-a1dcmbm1-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Server Configuration
NODE_ENV=production
PORT=3001

# External API Security - CHANGE THIS IN PRODUCTION!
API_KEY=whatsapp-lims-secure-api-key-2024
JWT_SECRET=your-jwt-secret-key

# WhatsApp Configuration
WHATSAPP_CLIENT_ID=default-client
MAX_CONCURRENT_SESSIONS=15
SESSION_TIMEOUT_MINUTES=30

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
DEFAULT_RATE_LIMIT_MESSAGES_PER_MINUTE=10
DEFAULT_RATE_LIMIT_MESSAGES_PER_HOUR=500

# Business Hours (for session strategies)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-app.com,https://your-admin-panel.com

# Replit Configuration
REPLIT_DOMAINS=