NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://voice.yourdomain.com

# Main platform connector. Add this endpoint to the existing platform or proxy it to your current agent flow.
PLATFORM_AGENT_URL=https://your-main-platform.com/api/voice-agent/respond
PLATFORM_AGENT_SECRET=change-me-shared-secret
VOICE_SESSION_TOKEN_SECRET=
DEFAULT_ORGANIZATION_ID=default_org
DEFAULT_USER_ID=default_user

# Optional cache for campaign/flow audio chunks.
# The table is created automatically when DATABASE_URL is present.
DATABASE_URL=postgres://user:password@host:25060/db?sslmode=require
# 32 random bytes encoded as base64, used only by the server to encrypt tenant API credentials.
VOICE_CREDENTIAL_ENCRYPTION_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VOICE_AUDIO_BUCKET=voice-flow-audio
VOICE_CACHE_ADMIN_TOKEN=

# Streaming mode: enables LLM streaming with sentence-by-sentence TTS for lower latency
# When enabled, first audio plays ~2-3s after user speaks instead of ~8s
ENABLE_STREAMING=true

# Plays a short acknowledgement while the platform/RAG answer is being prepared.
ENABLE_VOICE_FILLER=true

# STT provider. Use OpenAI directly, or "http" for a custom wrapper.
STT_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTIONS_URL=https://api.openai.com/v1/audio/transcriptions

# Only required when STT_PROVIDER=http.
STT_HTTP_URL=https://your-stt-provider.example.com/transcribe
STT_HTTP_API_KEY=your-stt-key

# TTS provider. Use Fish Audio directly, or "http" for a custom wrapper.
TTS_PROVIDER=fish
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_AUDIO_TTS_URL=https://api.fish.audio/v1/tts

# Fish Audio model options:
# - s1: Legacy model
# - s2: Fast, good quality (RECOMMENDED for voice agents)
# - s2-pro: Highest quality but slower
FISH_AUDIO_MODEL=s2

FISH_AUDIO_REFERENCE_ID=your-cloned-voice-model-id
FISH_AUDIO_FORMAT=mp3

# Lower bitrate = smaller audio = faster transmission
FISH_AUDIO_MP3_BITRATE=64

# Latency mode - IMPORTANT for voice agents:
# - normal: Highest quality, slowest (~3-4s TTS)
# - balanced: Good quality, faster (~1.5-2s TTS)
# - low: Fastest, may have quality tradeoffs (~1s TTS) - RECOMMENDED for voice agents
# Legacy value "lowest" is also accepted and normalized to "low".
FISH_AUDIO_LATENCY=low

FISH_AUDIO_TEMPERATURE=0.7
FISH_AUDIO_TOP_P=0.7
FISH_AUDIO_SPEED=1
FISH_AUDIO_VOLUME=0

# Only required when TTS_PROVIDER=http.
# Expected response JSON: { "audioBase64": "...", "mimeType": "audio/mpeg" }
# Optional for Twilio: { "twilioMulawBase64": "..." }
TTS_HTTP_URL=https://your-tts-provider.example.com/speech
TTS_HTTP_API_KEY=your-tts-key
TTS_VOICE_ID=default

# Twilio request validation is recommended in production.
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=false
